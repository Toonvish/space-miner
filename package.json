{
  "name": "space-miner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun tools/dev.ts",
    "dev:client": "bun --bun vite",
    "dev:server": "bun --watch server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p server && bun --bun vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "models": "bun tools/build-models.ts"
  },
  "dependencies": {
    "@colyseus/bun-websockets": "^0.18.4",
    "@colyseus/core": "^0.18.27",
    "@colyseus/schema": "^5.0.45",
    "@colyseus/sdk": "^0.18.9",
    "express": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
