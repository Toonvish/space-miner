# space-miner — copy to /opt/space-miner/.env on the server.
#
# The public hostname is NOT configured here: toon-household's Caddy serves it, so
# SPACE_MINER_HOSTNAME goes into /opt/toon-household/.env (toon-household ADR 0018).

# Image to run. The deploy script pins this to the exact digest of the last
# healthy deploy; leave it at :latest for the first start.
SPACE_MINER_IMAGE=ghcr.io/toonvish/space-miner:latest

# Docker network of the toon-household stack (compose project + network name).
# EDGE_NETWORK=toon-household_toon

# Hard memory cap for the game server container.
# SPACE_MINER_MEM_LIMIT=384m
